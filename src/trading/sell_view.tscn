[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://src/trading/sell_view.gd" id="1"]

[node name="SellView" type="VBoxContainer"]
layout_mode = 2
script = ExtResource("1")
theme_override_constants/separation = 8

[node name="Title" type="Label" parent="."]
layout_mode = 2
theme_type_variation = "H2"
text = "Your spare parts"

[node name="Intro" type="Label" parent="."]
layout_mode = 2
theme_type_variation = "Muted"
text = "Listing isn't instant payment. Negotiate in Messages and get paid at the meeting. Cancel a listing before installing its part."
autowrap_mode = 3

[node name="Scroll" type="ScrollContainer" parent="."]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="Box" type="VBoxContainer" parent="Scroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 10

[node name="Empty" type="Label" parent="Scroll/Box"]
visible = false
layout_mode = 2
theme_type_variation = "Muted"
text = "No spare parts. Installed components must be replaced at the workbench before selling."
autowrap_mode = 3