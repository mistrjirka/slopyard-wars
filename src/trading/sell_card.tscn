[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://src/trading/sell_card.gd" id="1"]

[node name="SellCard" type="PanelContainer"]
layout_mode = 2
theme_type_variation = "Card"
script = ExtResource("1")

[node name="Content" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Name" type="Label" parent="Content"]
layout_mode = 2
autowrap_mode = 3

[node name="Guide" type="Label" parent="Content"]
layout_mode = 2
theme_type_variation = "Tiny"
autowrap_mode = 3

[node name="Status" type="Label" parent="Content"]
layout_mode = 2
theme_type_variation = "Tiny"
autowrap_mode = 3

[node name="StatusAdvice" type="Label" parent="Content"]
visible = false
layout_mode = 2
theme_type_variation = "Tiny"
autowrap_mode = 3

[node name="ActiveActions" type="HBoxContainer" parent="Content"]
visible = false
layout_mode = 2
theme_override_constants/separation = 8

[node name="ChatBtn" type="Button" parent="Content/ActiveActions"]
custom_minimum_size = Vector2(0, 44)
layout_mode = 2
theme_type_variation = "PrimaryButton"
text = "Messages"

[node name="CancelBtn" type="Button" parent="Content/ActiveActions"]
custom_minimum_size = Vector2(0, 44)
layout_mode = 2
theme_type_variation = "DestructiveButton"
text = "Cancel listing"

[node name="ExpandBtn" type="Button" parent="Content"]
custom_minimum_size = Vector2(0, 44)
layout_mode = 2
size_flags_horizontal = 0
theme_type_variation = "GhostButton"
toggle_mode = true
text = "List for sale"

[node name="DraftForm" type="VBoxContainer" parent="Content"]
visible = false
layout_mode = 2
theme_override_constants/separation = 8

[node name="PriceLabel" type="Label" parent="Content/DraftForm"]
layout_mode = 2
text = "Asking price"

[node name="Price" type="SpinBox" parent="Content/DraftForm"]
custom_minimum_size = Vector2(0, 44)
layout_mode = 2
min_value = 1.0
max_value = 5000.0
prefix = "$"

[node name="QuickPrices" type="HFlowContainer" parent="Content/DraftForm"]
layout_mode = 2
theme_override_constants/h_separation = 8
theme_override_constants/v_separation = 6

[node name="GuideBtn" type="Button" parent="Content/DraftForm/QuickPrices"]
custom_minimum_size = Vector2(0, 44)
layout_mode = 2
theme_type_variation = "GhostButton"

[node name="QuickBtn" type="Button" parent="Content/DraftForm/QuickPrices"]
custom_minimum_size = Vector2(0, 44)
layout_mode = 2
theme_type_variation = "GhostButton"

[node name="DraftAdvice" type="Label" parent="Content/DraftForm"]
layout_mode = 2
theme_type_variation = "Tiny"
autowrap_mode = 3

[node name="PostBtn" type="Button" parent="Content/DraftForm"]
custom_minimum_size = Vector2(0, 44)
