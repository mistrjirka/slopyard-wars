[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://src/workshop/assembly.gd" id="1"]
[ext_resource type="Theme" path="res://resources/ui/assembly_theme.tres" id="2"]

[node name="Assembly" type="Control"]
custom_minimum_size = Vector2(780, 580)
texture_filter = 1
clip_contents = true
focus_mode = 2
theme = ExtResource("2")
script = ExtResource("1")

[node name="Footer" type="VBoxContainer" parent="."]
layout_mode = 1
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 16.0
offset_top = 402.0
offset_right = -16.0
offset_bottom = -8.0
grow_horizontal = 2
theme_override_constants/separation = 6
mouse_filter = 2

[node name="Hint" type="Label" parent="Footer"]
layout_mode = 2
size_flags_vertical = 0
theme_override_font_sizes/font_size = 18
autowrap_mode = 3
mouse_filter = 2

[node name="Penalties" type="Label" parent="Footer"]
layout_mode = 2
size_flags_vertical = 0
theme_type_variation = &"Tiny"
theme_override_font_sizes/font_size = 12
autowrap_mode = 3
mouse_filter = 2

[node name="ActionSpace" type="Control" parent="Footer"]
layout_mode = 2
size_flags_vertical = 3
mouse_filter = 2

[node name="Actions" type="HBoxContainer" parent="Footer"]
layout_mode = 2

[node name="Primary" type="Button" parent="Footer/Actions"]
layout_mode = 2
theme_type_variation = &"PrimaryButton"
mouse_default_cursor_shape = 2
text = "CONTINUE"

[node name="Secondary" type="Button" parent="Footer/Actions"]
layout_mode = 2
theme_type_variation = &"GhostButton"
mouse_default_cursor_shape = 2
