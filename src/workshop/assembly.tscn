text = "RETRY INSTALLATION"
tooltip_text = "Retry to improve paste and mounting. Physical damage does not reset."

[connection signal="minimum_size_changed" from="Footer" to="." method="_fit_footer"]
[connection signal="pressed" from="Footer/Actions/Primary" to="." method="_primary_pressed"]
[connection signal="pressed" from="Footer/Actions/Secondary" to="." method="_secondary_pressed"]
[connection signal="pressed" from="Footer/Actions/Retry" to="." method="_retry_pressed"]
