[gd_scene load_steps=1 format=3]

[node name="ConfirmationDialog" type="PanelContainer"]
layout_mode = 2
theme_type_variation = "CardRisk"

[node name="Box" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Title" type="Label" parent="Box"]
layout_mode = 2
theme_type_variation = "H2"

[node name="Text" type="Label" parent="Box"]
layout_mode = 2
autowrap_mode = 3

[node name="Buttons" type="HBoxContainer" parent="Box"]
layout_mode = 2
theme_override_constants/separation = 10
alignment = 2

[node name="Cancel" type="Button" parent="Box/Buttons"]
layout_mode = 2
theme_type_variation = "GhostButton"
text = "CANCEL"

[node name="Ok" type="Button" parent="Box/Buttons"]
layout_mode = 2
theme_type_variation = "RiskButton"
text = "OK"
