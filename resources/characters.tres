refusal_by_reason = {"hobby": "That loading bar has more character than this conversation. You're cut from the credits and the deal.", "lowball": "That's less a budget than a sad opening scene. I'll find another buyer.", "conduct": "Niko plays every character in my film. None of them need to be you. Deal's off."}
