price_accept = "${price}. Operation Reasonable Price is a success."
price_counter = "My counter-plan is ${price}. Minimal casualties, mostly my margin."
technical_reply = "The notes beat marketing stickers. Compare the actual scores and condition."
buyer_opening = "I can offer ${price}. I have a tiny whiteboard to support this."
favorite_topics = PackedStringArray("value per dollar", "organized plans")
pet_peeves = PackedStringArray("paying extra for a sticker")
