[sub_resource type="Resource" id="Character_eddie"]
script = ExtResource("2")
resource_name = "Fast Eddie"
id = "eddie"
refusal_by_reason = {"hobby": "My bike may be slow, but it gets me away from conversations like this. Deal's off.", "lowball": "That offer has two flat tyres. I'm riding away from this sale.", "conduct": "You've been disqualified before the starting line. No deal."}
personal_boundaries = "Your bicycle and racing ambitions are ridiculous but they are yours. Friendly banter is welcome; dismissing them with contempt earns an immediate disqualification from buying anything."
